            "lhs": {
              "call": "CardEffectCommons.IsExistOnBattleArea",
              "args": [
                {
                  "ref": "card"
                }
              ]
            },
            "rhs": {
              "opaque": "foreach (Permanent permanent in card.Owner.GetBattleAreaPermanents())\r\n                        {\r\n                            if (permanent.DigivolutionCards.Count \u003E= 5)\r\n                            {\r\n                                if (permanent.TopCard.CardNames.Contains(\u0022Mother D-Reaper\u0022))\r\n                                {\r\n                                    return true;\r\n                                }\r\n\r\n                                if (permanent.TopCard.CardNames.Contains(\u0022MotherD-Reaper\u0022))\r\n                                {\r\n                                    return true;\r\n                                }\r\n                            }\r\n                        }"
            }
