              "rhs": {
                "opaque": "DigiXrosConditionElement element = new DigiXrosConditionElement(CanSelectCardCondition,\r\n                            \u00221 Lv.4 Digimon card with [Composite] trait\u0022); bool CanSelectCardCondition(CardSource source)\r\n                        {\r\n                            return source \u0026\u0026 source.Owner == card.Owner \u0026\u0026\r\n                                   source.IsDigimon \u0026\u0026 source.HasLevel \u0026\u0026 source.IsLevel4 \u0026\u0026\r\n                                   source.CardTraits.Contains(\u0022Composite\u0022);\r\n                        } List\u003CDigiXrosConditionElement\u003E elements = new List\u003CDigiXrosConditionElement\u003E(); for (int i = 0; i \u003C 3; i\u002B\u002B)\r\n                        {\r\n                            elements.Add(element);\r\n                        } bool CanTargetConditionByPreSelectedList(List\u003CCardSource\u003E cardSources, CardSource source)\r\n                        {\r\n                            List\u003Cstring\u003E cardIDs = new List\u003Cstring\u003E();\r\n\r\n                            foreach (var cs in cardSources.Where(cs =\u003E !cardIDs.Contains(cs.CardID)))\r\n                            {\r\n                                cardIDs.Add(cs.CardID);\r\n                            }\r\n\r\n                            return !cardIDs.Contains(source.CardID);\r\n                        } DigiXrosCondition digiXrosCondition = new DigiXrosCondition(elements, CanTargetConditionByPreSelectedList, 1); return digiXrosCondition;"
              }
            },
            "rhs": {
              "null": true
            }
          }
        }
