              "rhs": {
                "opaque": "DigiXrosConditionElement elementRaijinmon = new DigiXrosConditionElement(SelectRaijinmonCondition, \u0022Raijinmon\u0022); bool SelectRaijinmonCondition(CardSource conditionCardSource)\r\n                        {\r\n                            if (conditionCardSource != null)\r\n                            {\r\n                                if (conditionCardSource.Owner == card.Owner)\r\n                                {\r\n                                    if (conditionCardSource.IsDigimon)\r\n                                    {\r\n                                        if (conditionCardSource.EqualsCardNameDigiXros(\u0022Raijinmon\u0022))\r\n                                        {\r\n                                            return true;\r\n                                        }\r\n                                    }\r\n                                }\r\n                            }\r\n\r\n                            return false;\r\n                        } DigiXrosConditionElement elementFujinmon = new DigiXrosConditionElement(SelectFujinmonCondition, \u0022Fujinmon\u0022); bool SelectFujinmonCondition(CardSource conditionCardSource)\r\n                        {\r\n                            if (conditionCardSource != null)\r\n                            {\r\n                                if (conditionCardSource.Owner == card.Owner)\r\n                                {\r\n                                    if (conditionCardSource.IsDigimon)\r\n                                    {\r\n                                        if (conditionCardSource.EqualsCardNameDigiXros(\u0022Fujinmon\u0022))\r\n                                        {\r\n                                            return true;\r\n                                        }\r\n                                    }\r\n                                }\r\n                            }\r\n\r\n                            return false;\r\n                        } DigiXrosConditionElement elementSuijinmon = new DigiXrosConditionElement(SelectSuijinmonCondition, \u0022Suijinmon\u0022); bool SelectSuijinmonCondition(CardSource conditionCardSource)\r\n                        {\r\n                            if (conditionCardSource != null)\r\n                            {\r\n                                if (conditionCardSource.Owner == card.Owner)\r\n                                {\r\n                                    if (conditionCardSource.IsDigimon)\r\n                                    {\r\n                                        if (conditionCardSource.EqualsCardNameDigiXros(\u0022Suijinmon\u0022))\r\n                                        {\r\n                                            return true;\r\n                                        }\r\n                                    }\r\n                                }\r\n                            }\r\n\r\n                            return false;\r\n                        } List\u003CDigiXrosConditionElement\u003E elements = new List\u003CDigiXrosConditionElement\u003E() { elementRaijinmon, elementFujinmon,  elementSuijinmon}; DigiXrosCondition digiXrosCondition = new DigiXrosCondition(elements, null, 2); return digiXrosCondition;"
              }
