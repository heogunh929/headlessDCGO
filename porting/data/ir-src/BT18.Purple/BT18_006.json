            "args": [
              {
                "ref": "hashtable"
              },
              {
                "ref": "card"
              }
            ]
          }
        },
        {
          "name": "OpponentColorCount",
          "returns": "int",
          "params": [],
          "body": {
            "opaque": "List\u003CCardColor\u003E cardColors = new List\u003CCardColor\u003E(); foreach (Permanent permanent in card.Owner.Enemy.GetBattleAreaPermanents()\r\n                                 .Where(permanent =\u003E permanent.IsDigimon || permanent.IsTamer))\r\n                    {\r\n                        cardColors.AddRange(permanent.TopCard.CardColors);\r\n                    } cardColors = cardColors.Distinct().ToList(); return cardColors.Count;"
          }
        },
        {
          "name": "CanActivateCondition",
          "returns": "bool",
          "params": [
            "hashtable"
          ],
          "body": {
            "call": "CardEffectCommons.CanActivateOnDeletion",
            "args": [
              {
                "ref": "hashtable"
              },
              {
                "ref": "card"
              }
            ]
          }
        },
        {
          "name": "ActivateCoroutine",
          "returns": "IEnumerator",
          "params": [
            "hashtable"
          ],
          "body": {
            "yields": [
              {
                "call": "new IAddTrashCardsFromLibraryTop(OpponentColorCount(), card.Owner, activateClass).AddTrashCardsFromLibraryTop",
                "args": []
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "kind": "activate",
          "var": "activateClass",
