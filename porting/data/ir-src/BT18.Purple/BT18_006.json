          "returns": "string",
          "params": [],
          "body": {
            "lit": "[On Deletion] Trash the top card of your deck for each color of your opponent\u0027s Digimon and Tamers."
          }
        },
        {
          "name": "CanUseCondition",
          "returns": "bool",
          "params": [
