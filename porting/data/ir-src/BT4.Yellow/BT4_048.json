  "className": "BT4_048",
  "branches": [
    {
      "timing": "OnAllyAttack",
      "localFns": [
        {
          "name": "EffectDiscription",
          "returns": "string",
          "params": [],
          "body": {
            "lit": "[When Attacking][Once Per Turn] You may add the top card of your security stack to your hand to unsuspend this Digimon and have 1 of your opponent\u0027s Digimon get -6000 DP for the turn."
          }
        },
        {
          "name": "CanSelectPermanentCondition",
          "returns": "bool",
          "params": [
            "permanent"
          ],
          "body": {
            "call": "CardEffectCommons.IsPermanentExistsOnOpponentBattleAreaDigimon",
            "args": [
              {
                "ref": "permanent"
              },
              {
                "ref": "card"
              }
            ]
          }
        },
        {
          "name": "CanUseCondition",
          "returns": "bool",
          "params": [
            "hashtable"
          ],
          "body": {
            "call": "CardEffectCommons.CanTriggerOnAttack",
            "args": [
              {
                "ref": "hashtable"
              },
              {
                "ref": "card"
              }
            ]
          }
        },
        {
          "name": "CanActivateCondition",
          "returns": "bool",
          "params": [
            "hashtable"
          ],
          "body": {
            "binop": "\u0026\u0026",
            "lhs": {
              "call": "CardEffectCommons.IsExistOnBattleArea",
              "args": [
                {
                  "ref": "card"
                }
              ]
            },
            "rhs": {
              "binop": "\u003E=",
              "lhs": {
                "member": "card.Owner.SecurityCards.Count"
              },
              "rhs": {
                "lit": 1
              }
            }
          }
        },
        {
          "name": "ActivateCoroutine",
          "returns": "IEnumerator",
          "params": [
            "_hashtable"
          ],
          "body": {
            "yields": [
              {
                "call": "CardObjectController.AddHandCards",
                "args": [
                  {
                    "opaque": "new List\u003CCardSource\u003E() { topCard }"
                  },
                  {
                    "const": false
                  },
                  {
                    "ref": "activateClass"
                  }
                ]
              },
              {
                "call": "new IReduceSecurity(\r\n                        player: card.Owner,\r\n                        refSkillInfos: ref ContinuousController.instance.nullSkillInfos,\r\n                        activateClass).ReduceSecurity",
                "args": []
              },
              {
                "call": "new IUnsuspendPermanents(new List\u003CPermanent\u003E() { selectedPermanent }, activateClass).Unsuspend",
                "args": []
              },
              {
                "call": "selectPermanentEffect.Activate",
                "args": []
              },
              {
                "call": "CardEffectCommons.ChangeDigimonDP",
                "args": [
                  {
                    "ref": "permanent"
                  },
                  {
                    "opaque": "-6000"
                  },
                  {
                    "member": "EffectDuration.UntilEachTurnEnd"
                  },
                  {
                    "ref": "activateClass"
                  }
                ]
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "opaque": "activateClass.SetHashString(\u0022Unsuspend_BT4_048\u0022);"
        },
        {
          "kind": "activate",
          "var": "activateClass",
          "label": {
            "lit": "Unsuspend this Digimon and opponent\u0027s Digimon gains DP -6000"
          },
          "useCondition": "CanUseCondition",
          "activateCondition": "CanActivateCondition",
          "coroutine": "ActivateCoroutine",
          "description": {
            "call": "EffectDiscription",
            "args": []
          }
        }
      ]
    }
  ]
