          "name": "GetJogress",
          "returns": "JogressCondition",
          "params": [
            "cardSource"
          ],
          "body": {
            "binop": "\u0026\u0026",
            "lhs": {
              "binop": "\u0026\u0026",
              "lhs": {
                "binop": "==",
                "lhs": {
                  "ref": "cardSource"
