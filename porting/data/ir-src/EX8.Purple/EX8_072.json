          "body": {
            "opaque": "var levelMax = 7 - (card.Owner.Enemy.HandCards.Count / 3); if (CardEffectCommons.IsPermanentExistsOnOpponentBattleAreaDigimon(permanent, card))\r\n                    {\r\n                        if (permanent.TopCard.HasLevel \u0026\u0026 permanent.Level \u003C= levelMax)\r\n                        {\r\n                            return true;\r\n                        }\r\n                    } return false;"
          }
