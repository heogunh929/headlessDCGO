      "timing": "OnEnterFieldAnyone",
      "localFns": [
        {
          "name": "EffectDiscription",
          "returns": "string",
          "params": [],
          "body": {
            "lit": "[On Play] You may search your security stack for 1 Digimon card with [Warrior] or [Holy Warrior] in its type, reveal it, and add it to your hand. If you do, trigger \u003CRecovery \u002B1 (Deck)\u003E. (Place the top card of your deck on top of your security stack.) Then, shuffle your security stack."
          }
        },
        {
          "name": "CanSelectCardCondition",
          "returns": "bool",
          "params": [
            "cardSource"
          ],
          "body": {
            "binop": "\u0026\u0026",
            "lhs": {
              "member": "cardSource.IsDigimon"
            },
            "rhs": {
              "binop": "\u0026\u0026",
              "lhs": {
                "binop": "\u0026\u0026",
                "lhs": {
                  "call": "cardSource.CardTraits.Contains",
                  "args": [
                    {
                      "lit": "Warrior"
                    }
                  ]
                },
                "rhs": {
                  "call": "cardSource.CardTraits.Contains",
                  "args": [
                    {
                      "lit": "Holy Warrior"
                    }
                  ]
                }
              },
              "rhs": {
                "call": "cardSource.CardTraits.Contains",
                "args": [
                  {
                    "lit": "HolyWarrior"
                  }
                ]
              }
            }
          }
        },
        {
          "name": "CanUseCondition",
          "returns": "bool",
          "params": [
            "hashtable"
          ],
          "body": {
            "call": "CardEffectCommons.CanTriggerOnPlay",
            "args": [
              {
                "ref": "hashtable"
              },
              {
                "ref": "card"
              }
            ]
          }
        },
        {
          "name": "CanActivateCondition",
          "returns": "bool",
          "params": [
            "hashtable"
          ],
          "body": {
            "binop": "\u0026\u0026",
            "lhs": {
              "call": "CardEffectCommons.IsExistOnBattleArea",
              "args": [
                {
                  "ref": "card"
                }
              ]
            },
            "rhs": {
              "binop": "\u003E=",
              "lhs": {
                "member": "card.Owner.SecurityCards.Count"
              },
              "rhs": {
                "lit": 1
              }
            }
          }
        },
        {
          "name": "ActivateCoroutine",
          "returns": "IEnumerator",
          "params": [
            "_hashtable"
          ],
          "body": {
            "yields": [
              {
                "call": "selectCardEffect.Activate",
                "args": []
              },
              {
                "call": "new IReduceSecurity(\r\n                                player: card.Owner,\r\n                                refSkillInfos: ref ContinuousController.instance.nullSkillInfos,\r\n                                activateClass).ReduceSecurity",
                "args": []
              },
              {
                "null": true
              },
              {
                "call": "new IRecovery(card.Owner, 1, activateClass).Recovery",
                "args": []
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "kind": "activate",
          "var": "activateClass",
          "label": {
