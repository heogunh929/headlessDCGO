                      }
                    ]
                  }
                },
                "rhs": {
                  "call": "cardSource.CardTraits.Contains",
                  "args": [
                    {
                      "lit": "DarkAnimal"
                    }
                  ]
                }
              }
            }
          }
        },
        {
