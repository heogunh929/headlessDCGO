            "lhs": {
              "call": "CardEffectCommons.IsPermanentExistsOnOwnerBattleAreaDigimon",
              "args": [
                {
                  "ref": "permanent"
                },
                {
                  "ref": "card"
                }
              ]
            },
            "rhs": {
              "opaque": "foreach (CardSource cardSource in card.Owner.TrashCards)\r\n                        {\r\n                            if (CanSelectCardCondition(cardSource))\r\n                            {\r\n                                if (cardSource.CanPlayCardTargetFrame(permanent.PermanentFrame, true, activateClass))\r\n                                {\r\n                                    return true;\r\n                                }\r\n                            }\r\n                        }"
            }
          }
        },
