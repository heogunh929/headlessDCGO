            "opaque": "List\u003Cstring\u003E cardNames = GetNamesList(cardSources); foreach (string name in cardNames)\r\n                    {\r\n                        if (cardSource.CardNames.Contains(name))\r\n                            return false;\r\n                    } return true;"
          }
