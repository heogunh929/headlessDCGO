                "opaque": "DigiXrosConditionElement elementAgunimon =\r\n                            new DigiXrosConditionElement(CanSelectCardConditionAgunimon, \u0022Agunimon\u0022); bool CanSelectCardConditionAgunimon(CardSource conditionCardSource)\r\n                        {\r\n                            if (conditionCardSource != null)\r\n                            {\r\n                                if (conditionCardSource.Owner == card.Owner)\r\n                                {\r\n                                    if (conditionCardSource.IsDigimon)\r\n                                    {\r\n                                        if (conditionCardSource.CardNames_DigiXros.Contains(\u0022Agunimon\u0022))\r\n                                        {\r\n                                            return true;\r\n                                        }\r\n                                    }\r\n                                }\r\n                            }\r\n\r\n                            return false;\r\n                        } DigiXrosConditionElement elementBurningGreymon =\r\n                            new DigiXrosConditionElement(CanSelectCardConditionBurningGreymon, \u0022BurningGreymon\u0022); bool CanSelectCardConditionBurningGreymon(CardSource conditionCardSource)\r\n                        {\r\n                            if (conditionCardSource != null)\r\n                            {\r\n                                if (conditionCardSource.Owner == card.Owner)\r\n                                {\r\n                                    if (conditionCardSource.IsDigimon)\r\n                                    {\r\n                                        if (conditionCardSource.CardNames_DigiXros.Contains(\u0022BurningGreymon\u0022))\r\n                                        {\r\n                                            return true;\r\n                                        }\r\n                                    }\r\n                                }\r\n                            }\r\n\r\n                            return false;\r\n                        } List\u003CDigiXrosConditionElement\u003E elements = new List\u003CDigiXrosConditionElement\u003E()\r\n                            { elementAgunimon, elementBurningGreymon }; DigiXrosCondition digiXrosCondition = new DigiXrosCondition(elements, null, 3); return digiXrosCondition;"
