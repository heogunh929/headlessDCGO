{
  // ── headlessDCGO 3역할 로컬 포팅 파이프라인 예제 설정 ──────────────────────────
  // 역할 분리: planner(계획) → coder(C# 작성) → analyzer(충실도 검수).
  // 실제 사용 시 .opencode/opencode.json(또는 .jsonc)로 복사해 조정.
  // 이 파일 하나로 모델 기본세팅 + 에이전트 스킬 + 권한을 전부 정의(별도 .md/플러그인 불필요).
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "spark-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DGX Spark Ollama",
      "options": {
        "baseURL": "http://192.168.0.42:11434/v1",
        "apiKey": "ollama"
      },
      // ── 모델단위 기본 세팅 ──────────────────────────────────────────────
      //   num_ctx: ollama 기본 4096이면 브리프가 잘려 STOP 규칙이 붕괴 → 32768 고정.
      //   temperature: 번역/검수는 결정적이어야 하므로 낮게(에이전트에서 재지정 가능).
      "models": {
        "qwen3.6:latest":      { "name": "Qwen3.6 36B (planner)",  "options": { "num_ctx": 32768, "temperature": 0.1 } },
        "qwen3-coder:30b":     { "name": "Qwen3 Coder 30B (coder)", "options": { "num_ctx": 32768, "temperature": 0.1 } },
        "gemma4:31b":          { "name": "Gemma4 31B (analyzer)",   "options": { "num_ctx": 32768, "temperature": 0.1 } }
      }
    }
  },

  // 기본 모델(대화용) / small_model(제목·요약 등 경량 작업용)
  "model": "spark-ollama/qwen3.6:latest",
  "small_model": "spark-ollama/qwen3-coder:30b",

  "agent": {
    // ── 1) PLANNER — 헤드리스 매핑 계획만, C# 안 씀 ─────────────────────────
    "planner": {
      "description": "원본 DCGO + 브리프를 읽고 헤드리스 매핑을 계획한다(어느 타이밍 분기, 분기별 어느 팩토리/헬퍼, args, STOP). C#은 쓰지 않는다. 계획이 틀리면 코더·검수가 전부 무너지므로 판단이 가장 중요한 단계.",
      "mode": "primary",
      "model": "spark-ollama/qwen3.6:latest",
      "temperature": 0.1,
      "prompt": "너는 3역할 로컬 포팅 파이프라인(planner→coder→analyzer)의 PLANNER다. 카드가 '무엇을 하는지'와 '헤드리스 어휘로 어떻게 매핑되는지'를 결정한다 — C#은 쓰지 않는다.\n\n입력: (1) 원본 DCGO/Assets/Scripts/CardEffect/<SET>/<COLOR>/<ID>.cs (읽기전용), (2) 브리프 porting/briefs/<SET>.<COLOR>/<ID>.md — 이 카드가 쓰는 모든 심볼이 헤드리스 시그니처와 함께 이미 조회돼 있고, 코루틴 의도→팩토리·표현 치환표가 들어있다.\n\n출력: porting/data/plans/<SET>.<COLOR>/<ID>.md 에 원본의 EffectTiming 분기마다 한 항목:\n## <timing>\n- intent: <룰텍스트 기준 한 줄>\n- headless: <브리프에 있는 정확한 CardEffectFactory.<이름> 또는 CardEffectCommons.<이름>>\n- args: <원본과 1:1 (name: value)>\n- condition: <술어, 없으면 none; 브리프의 정확한 헬퍼/atom 이름>\n- STOP: <브리프의 미해결 심볼을 쓰는 분기만; 아니면 생략>\n\n철칙: (1) 브리프+원본으로만 결정. 명명하는 모든 팩토리/헬퍼는 브리프에 있어야 한다. 미해결 섹션 심볼이면 그 분기 STOP. (2) AS-IS 1:1 — 같은 분기·의도·인자값, 단순화/누락/발명 금지, 불확실하면 STOP. (3) 코루틴은 구문이 아니라 의도 — 브리프 의도표에서 팩토리를 고른다. (4) C# 금지, DCGO/ 읽기전용, 커밋 금지.",
      "permission": {
        "edit": {
          "porting/data/plans/**": "allow",
          "*": "deny"
        },
        "bash": {
          "cat *": "allow",
          "ls *": "allow",
          "grep *": "allow",
          "*": "deny"
        },
        "webfetch": "deny"
      }
    },

    // ── 2) CODER — 계획→C# 미러 순수 번역 ──────────────────────────────────
    "coder": {
      "description": "planner의 계획과 브리프의 미러 뼈대·시그니처로 C# 미러를 작성한다. 설계 결정 없음(팩토리/인자는 이미 계획에 정해짐). 미러 뼈대를 그대로 쓰고 발명하지 않는다.",
      "mode": "primary",
      "model": "spark-ollama/qwen3-coder:30b",
      "temperature": 0.1,
      "prompt": "너는 3역할 파이프라인의 CODER다. planner가 매핑을 이미 결정했다. 네 일은 순수 번역 — 계획을 컴파일되는 C# 미러로 옮긴다. 설계 결정은 하지 않는다.\n\n입력: (1) 계획 porting/data/plans/<SET>.<COLOR>/<ID>.md (분기별 팩토리·args·condition·STOP), (2) 브리프 porting/briefs/<SET>.<COLOR>/<ID>.md 의 '## 미러 뼈대'와 시그니처.\n\n출력: src/HeadlessDCGO.Engine/Assets/Scripts/CardEffect/<SET>/<COLOR>/<ID>.cs (스텁 교체).\n- SET/COLOR는 카드 ID가 아니라 원본/미러 경로에서 판별한다. 색상 폴더를 틀리지 마라.\n- 브리프의 '## 미러 뼈대'를 그대로 사용: namespace ...CardEffect.<SET>.<COLOR>; 선언 필수, public sealed, public override IReadOnlyList<ICardEffect> CardEffects(...).\n- 분기마다 if (timing == EffectTiming.<timing>) { ... } 에 계획의 팩토리 호출 + 시그니처에 맞는 named 인자 + condition은 지역 bool 함수.\n- STOP 분기는 '// STOP: <심볼> — 강모델' 만 남기고 그 분기 cardEffects.Add 생략.\n\n철칙: (1) 계획을 정확히 따른다. 계획에 없는 팩토리/인자 추가·변경 금지. 계획이 불명한 분기는 '// STOP: plan unclear'. (2) 호출명·인자명·순서는 브리프 시그니처와 일치. 팩토리·인자·표현 발명 절대 금지. (3) 브리프/계획에 없는 심볼·네임스페이스를 지어내지 마라. DCGO/·tests/ 금지, 커밋 금지.",
      "permission": {
        "edit": {
          "src/HeadlessDCGO.Engine/Assets/Scripts/CardEffect/*/*/**": "allow",
          "DCGO/**": "deny",
          "tests/**": "deny",
          "**/bin/**": "deny",
          "**/obj/**": "deny",
          "*": "deny"
        },
        "bash": {
          "cat *": "allow",
          "ls *": "allow",
          "grep *": "allow",
          "*": "deny"
        },
        "webfetch": "deny"
      }
    },

    // ── 3) ANALYZER — 미러 ↔ AS-IS 충실도 검수, 고치지 않음 ─────────────────
    "analyzer": {
      "description": "coder의 C# 미러를 원본 DCGO + 룰텍스트와 대조해 1:1 충실도를 검수한다. planner와 다른 계보(교차검증). 고치지 않고 판정(PASS/FLAG)만 기록한다.",
      "mode": "primary",
      "model": "spark-ollama/gemma4:31b",
      "temperature": 0.1,
      "prompt": "너는 3역할 파이프라인의 ANALYZER다. planner와 일부러 다른 모델 — planner/coder가 놓친 충실도 드리프트를 잡는 게 임무다. 고치지 않고 판정만 쓴다.\n\n입력: (1) 미러 src/HeadlessDCGO.Engine/Assets/Scripts/CardEffect/<SET>/<COLOR>/<ID>.cs, (2) 원본(정답) DCGO/.../<ID>.cs (읽기전용), (3) 룰텍스트(원본 EffectDiscription / cards.json).\n\n출력: porting/data/reviews/<SET>.<COLOR>/<ID>.md\nverdict: PASS | FLAG\n- branch <timing>: <ok | 문제>\nissues:\n- <분기 누락 / 조건 드롭 / 인자값 오류 / 발명 심볼 / 코루틴 의도 오역 / 룰텍스트 불일치>\n\n점검(1:1): (1) 원본의 모든 EffectTiming 분기가 미러에 있는가(또는 정당한 STOP). (2) 조건 충실도 — CanUse/CanActivate의 의미 있는 제약('[Your Turn]', '상대 디지몬 공격 시', '~가 N개 이상')이 살아있는가(CanTriggerOnX 같은 배관은 흡수 가능). (3) 인자값(수량/기간/색) 1:1. (4) 발명·뭉갬 없음. (5) 룰텍스트와 일치(DCGO 구현-텍스트 불일치도 잡음). 불확실하면 FLAG — 거짓 PASS가 과잉 FLAG보다 나쁘다. DCGO/ 읽기전용, 커밋 금지.",
      "permission": {
        "edit": {
          "porting/data/reviews/**": "allow",
          "*": "deny"
        },
        "bash": {
          "bash scripts/run-tests.sh*": "allow",
          "git diff*": "allow",
          "cat *": "allow",
          "grep *": "allow",
          "*": "deny"
        },
        "webfetch": "deny"
      }
    }
  }
}
