<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- AS-IS 소스는 구형 .NET/Unity 런타임 대상이다. .NET 8이 오류로 승격시킨 폐기 API를 경고로 되돌린다.
         SYSLIB0011 = BinaryFormatter (Script/PlayerPrefsUtil.cs, 범위 밖 파일). AS-IS 코드는 고치지 않는다. -->
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- (G6-003) Card-stat data generated by tools/CardDataConverter from the local DCGO/ assets. -->
    <!-- old-TO-BE 의 카드 데이터 임베드. 소비자였던 Headless/DataLoading 과 함께 제거됐다.
         데이터 자체는 ~/git/headlessDCGO.handport-backup/Assets/CardBaseEntity/ (44M) 에 보존.
         AS-IS 는 자체 DataBase/DeckData 로 StreamingAssets 에서 읽는다 — 공급 경로 결정은 로드맵 단계 2. -->
  </ItemGroup>
</Project>
